#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Frame
{
    float4x4 rot_view_proj;
    float4 camera;
    float4 eye;
    float4 clip_plane;
};

struct type_Draw
{
    float4x4 model;
};

struct type_Material
{
    float4 base_color;
    float4 emissive;
    float4 params;
    float4 light0;
    float4 light1;
    float4 extra;
    float4 part_color_alpha;
};

struct type_BallShadows
{
    float4 lightCenter_doShadow;
    float4 balls[8];
};

struct type_Flasher
{
    float4 static_color_alpha;
    float4 alpha_test_filter_add;
    float4 amount_mva_mode;
    float4 flasher_term;
};

struct type_Dmd
{
    float4 dmd_tint;
    float4 dmd_res_alpha_time;
};

struct fs_light_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct fs_light_in
{
    float3 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment fs_light_out fs_light(fs_light_in in [[stage_in]], constant type_Material& Material [[buffer(0)]])
{
    fs_light_out out = {};
    float _64 = length(in.in_var_TEXCOORD0 - Material.params.xyz) * Material.params.w;
    out.out_var_SV_Target0 = float4(((mix(Material.emissive.xyz, Material.base_color.xyz, float3(sqrt(_64))) * powr(1.0 - fast::clamp(_64, 0.0, 1.0), Material.emissive.w)) * Material.base_color.w) * Material.light0.x, 1.0);
    return out;
}

