#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Overlay
{
    float4 screen;
};

struct type_BackdropLight
{
    float4 light_color_intensity;
    float4 light_color2_power;
    float4 light_center_range;
    float4 light_mode;
};

struct sprite_fs_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct sprite_fs_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
    float4 in_var_TEXCOORD1 [[user(locn1)]];
};

fragment sprite_fs_out sprite_fs(sprite_fs_in in [[stage_in]], texture2d<float> font_texture [[texture(0)]], sampler font_sampler [[sampler(0)]])
{
    sprite_fs_out out = {};
    float4 _38 = font_texture.sample(font_sampler, in.in_var_TEXCOORD0);
    if (_38.w < in.in_var_TEXCOORD1.w)
    {
        discard_fragment();
    }
    out.out_var_SV_Target0 = float4(_38.xyz * in.in_var_TEXCOORD1.xyz, 1.0);
    return out;
}

