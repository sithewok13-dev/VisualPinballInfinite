#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Overlay
{
    float4 screen;
};

struct type_BackdropLight
{
    float4 light_color_intensity;
    float4 light_color2_power;
    float4 light_center_range;
    float4 light_mode;
};

struct type_Dmd
{
    float4 dmd_tint;
    float4 dmd_res_alpha_time;
};

struct overlay_vs_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct overlay_vs_in
{
    float2 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD1 [[attribute(1)]];
    float4 in_var_TEXCOORD2 [[attribute(2)]];
};

vertex overlay_vs_out overlay_vs(overlay_vs_in in [[stage_in]], constant type_Overlay& Overlay [[buffer(0)]])
{
    overlay_vs_out out = {};
    out.gl_Position = float4((in.in_var_TEXCOORD0 * Overlay.screen.xy) + float2(-1.0, 1.0), 0.0, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    return out;
}

