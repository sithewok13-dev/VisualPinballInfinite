#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Frame
{
    float4x4 rot_view_proj;
    float4 camera;
    float4 eye;
    float4 clip_plane;
};

struct type_Draw
{
    float4x4 model;
};

struct type_Material
{
    float4 base_color;
    float4 emissive;
    float4 params;
    float4 light0;
    float4 light1;
    float4 extra;
    float4 part_color_alpha;
};

struct type_BallShadows
{
    float4 lightCenter_doShadow;
    float4 balls[8];
};

struct type_Flasher
{
    float4 static_color_alpha;
    float4 alpha_test_filter_add;
    float4 amount_mva_mode;
    float4 flasher_term;
};

struct type_Dmd
{
    float4 dmd_tint;
    float4 dmd_res_alpha_time;
};

struct vs_kicker_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float3 out_var_TEXCOORD1 [[user(locn1)]];
    float2 out_var_TEXCOORD2 [[user(locn2)]];
    float3 out_var_TEXCOORD3 [[user(locn3)]];
    float4 gl_Position [[position]];
    float gl_ClipDistance [[clip_distance]] [1];
    float gl_ClipDistance_0 [[user(clip0)]];
};

struct vs_kicker_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
    float2 in_var_TEXCOORD2 [[attribute(2)]];
};

vertex vs_kicker_out vs_kicker(vs_kicker_in in [[stage_in]], constant type_Frame& Frame [[buffer(0)]], constant type_Draw& Draw [[buffer(1)]])
{
    vs_kicker_out out = {};
    float4 _82 = Draw.model * float4(in.in_var_TEXCOORD0, 1.0);
    float3 _83 = _82.xyz;
    float4 _94 = Frame.rot_view_proj * float4(_83 - Frame.camera.xyz, 1.0);
    _94.z = (Frame.rot_view_proj * float4((Draw.model * float4(in.in_var_TEXCOORD0.xy, in.in_var_TEXCOORD0.z - 30.0, 1.0)).xyz - Frame.camera.xyz, 1.0)).z;
    out.gl_Position = _94;
    out.out_var_TEXCOORD0 = _83;
    out.out_var_TEXCOORD1 = (Draw.model * float4(in.in_var_TEXCOORD1, 0.0)).xyz;
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD2;
    out.out_var_TEXCOORD3 = Frame.eye.xyz - _83;
    out.gl_ClipDistance[0u] = dot(Frame.clip_plane, float4(_82.xyz, 1.0));
    out.gl_ClipDistance_0 = out.gl_ClipDistance[0];
    return out;
}

