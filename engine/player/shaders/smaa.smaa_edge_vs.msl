#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Post
{
    float4 w_h_height;
    float4 post_flags;
};

struct type_PostVertex
{
    float4 smaa_vs_metrics;
};

struct smaa_edge_vs_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 out_var_TEXCOORD1 [[user(locn1)]];
    float4 out_var_TEXCOORD2 [[user(locn2)]];
    float4 out_var_TEXCOORD3 [[user(locn3)]];
    float4 gl_Position [[position]];
};

vertex smaa_edge_vs_out smaa_edge_vs(constant type_PostVertex& PostVertex [[buffer(0)]], uint gl_VertexIndex [[vertex_id]])
{
    smaa_edge_vs_out out = {};
    float2 _60 = float2(float((gl_VertexIndex << 1u) & 2u), float(gl_VertexIndex & 2u));
    float4 _67 = _60.xyxy;
    out.gl_Position = float4((_60 * float2(2.0, -2.0)) + float2(-1.0, 1.0), 0.0, 1.0);
    out.out_var_TEXCOORD0 = _60;
    out.out_var_TEXCOORD1 = fma(PostVertex.smaa_vs_metrics.xyxy, float4(-1.0, 0.0, 0.0, -1.0), _67);
    out.out_var_TEXCOORD2 = fma(PostVertex.smaa_vs_metrics.xyxy, float4(1.0, 0.0, 0.0, 1.0), _67);
    out.out_var_TEXCOORD3 = fma(PostVertex.smaa_vs_metrics.xyxy, float4(-2.0, 0.0, 0.0, -2.0), _67);
    return out;
}

