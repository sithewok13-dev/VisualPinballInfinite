#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_StillWeights
{
    float4 still_weights;
};

struct still_restore_color_fs_out
{
    float4 out_var_SV_Target [[color(0)]];
};

fragment still_restore_color_fs_out still_restore_color_fs(texture2d<float> still_picture [[texture(0)]], float4 gl_FragCoord [[position]])
{
    still_restore_color_fs_out out = {};
    out.out_var_SV_Target = still_picture.read(uint2(int3(int(gl_FragCoord.x), int(gl_FragCoord.y), 0).xy), 0);
    return out;
}

