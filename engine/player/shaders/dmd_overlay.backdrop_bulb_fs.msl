#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Overlay
{
    float4 screen;
};

struct type_BackdropLight
{
    float4 light_color_intensity;
    float4 light_color2_power;
    float4 light_center_range;
    float4 light_mode;
};

struct type_Dmd
{
    float4 dmd_tint;
    float4 dmd_res_alpha_time;
};

constant float _42 = {};

struct backdrop_bulb_fs_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct backdrop_bulb_fs_in
{
    float4 in_var_TEXCOORD1 [[user(locn1)]];
};

fragment backdrop_bulb_fs_out backdrop_bulb_fs(backdrop_bulb_fs_in in [[stage_in]], constant type_BackdropLight& BackdropLight [[buffer(0)]])
{
    backdrop_bulb_fs_out out = {};
    float4 _107;
    do
    {
        float _57 = length(BackdropLight.light_center_range.xyz - float3(in.in_var_TEXCOORD1.xy, 0.0)) * BackdropLight.light_center_range.w;
        float3 _80 = float4(mix(BackdropLight.light_color2_power.xyz, BackdropLight.light_color_intensity.xyz, float3(sqrt(_57))) * (powr(1.0 - fast::clamp(_57, 0.0, 1.0), BackdropLight.light_color2_power.w) * BackdropLight.light_color_intensity.w), _42).xyz;
        if (BackdropLight.light_mode.z == 2.0)
        {
            _107 = float4(_80 * (-BackdropLight.light_mode.y), (1.0 / BackdropLight.light_mode.y) - 1.0);
            break;
        }
        float _101;
        if (BackdropLight.light_mode.z == 0.0)
        {
            _101 = BackdropLight.light_mode.y;
        }
        else
        {
            _101 = 1.0 - BackdropLight.light_mode.y;
        }
        _107 = float4(_80 * _101, 1.0);
        break;
    } while(false);
    out.out_var_SV_Target0 = _107;
    return out;
}

